# Copy to .env. Every value below is optional; the defaults match docker-compose.yml.

# Host-side producer talks to the EXTERNAL listener; containers use kafka:9092 automatically.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_EXTERNAL_PORT=9094
KAFKA_TOPIC_SERVER_LOGS=server-logs
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_STARTING_OFFSETS=latest

ELASTIC_VERSION=8.15.3
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
# For a secured remote cluster, set one of:
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

KIBANA_PORT=5601

# Detector tuning
WINDOW_SECONDS=60
THRESHOLD_UNAUTHORIZED=100
THRESHOLD_ERROR_RATE=0.01
THRESHOLD_SURGE_MULTIPLIER=5
SPARK_LOG_LEVEL=WARN
SPARK_GPU_ENABLED=false

# Web dashboard
PORT=3000
# Serve generated sample data when Elasticsearch is not running:
# DEMO_MODE=true
